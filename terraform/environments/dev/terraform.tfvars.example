aws_region          = "ap-south-1"
environment         = "dev"
cluster_name        = "todo-app-eks-dev"
cluster_version     = "1.37"
vpc_cidr            = "10.0.0.0/16"
node_instance_types = ["t3.medium", "t3a.medium", "t2.medium"]
node_capacity_type  = "SPOT"
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
